      "css": ".ds-readouts{display:grid;grid-template-columns:1fr 1fr;gap:1px;width:280px;background:rgba(158,205,214,.13);border:1px solid rgba(158,205,214,.13);border-radius:6px;overflow:hidden} .ds-row{display:flex;justify-content:space-between;align-items:baseline;gap:8px;padding:6px 9px;background:#0c1c27} .ds-row>span:first-child{font:600 12px 'Manrope',system-ui,sans-serif;color:#84a0a8} .ds-row>span:last-child{font:500 13px 'DM Mono',ui-monospace,monospace;font-variant-numeric:tabular-nums;color:#e6efef} .ds-row>.ds-warn{color:#f4c76a}"
