  "narrative": {
    "northStar": "The Night Bridge Console",
    "overview": "One instrument, not a form. The chart is the stage and the ASD console and vector readouts are the product. The system is an integrated bridge display at night: a navy-teal ground, hairline-edged panels, tabular numerals, and color that carries meaning (port, starboard, caution, alarm) rather than decoration. It is built for large bridge screens in low light, so contrast is generous and the text floor is 11px.\n\nDensity is high but quiet. Setup lives in collapsible groups and two-column fields; help text hides behind a small info toggle rather than sitting as paragraphs. Floating HUD elements sit on the chart (compass top-center, a collapsible force-model pill top-left under the zoom control at top 100px / left 12px, rose top-right, ASD dock bottom-center) so drift and forces are read without scrolling. Groups that serve a secondary task, such as Derrota, start closed.",
    "keyCharacteristics": [
      "Three-column shell: 296px setup accordion, full-bleed chart, 304px telemetry; 48px top bar.",
      "Tonal depth: four navy surface steps and 1px hairlines, with shadows reserved for floating layers.",
      "DM Mono tabular numerals for every value; Manrope for labels and actions.",
      "One cyan accent for selection and the primary action; port red and starboard green identify sides.",
      "Drawn SVG line icons (16px, 1.75 stroke), no emoji."
    ],
    "rules": [
      {
        "name": "Chart overlay colors (named exception)",
        "body": "Map vectors, compass tape, Chart.js series and legend swatches use brighter hues (#00d4ff, #b48cf2, #f97316, #a78bfa, buoy fills) so they read over the light chart. They are off the console tokens by design; never use them for console chrome.",
        "section": "colors"
      },
      {
        "name": "The Meaning-Only Color Rule",
        "body": "Port red, starboard green, amber, coral and violet appear only when they encode side, state, alarm or the AI. They are never decorative fills.",
        "section": "colors"
      },
      {
        "name": "The One Accent Rule",
        "body": "Cyan alone marks selection, focus and the single primary action on screen.",
        "section": "colors"
      },
      {
        "name": "The Tabular Numerals Rule",
        "body": "Every changing number is DM Mono with tabular figures. Prose and labels never use it.",
        "section": "typography"
      },
      {
        "name": "The 11px Floor Rule",
        "body": "Nothing on the interface or the chart is below 11px, including chart-drawn labels and sounding subscripts. There is no exception.",
        "section": "typography"
      },
      {
        "name": "The Flat Panels Rule",
        "body": "Docked panels never carry shadows; only floating layers do, and always soft, large-blur, black.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the surface steps (#08151e to #183242) and 1px hairlines to separate regions.",
      "Do set every changing number in DM Mono with tabular figures.",
      "Do reserve cyan (#5fd6d0) for selection, focus and the one primary action.",
      "Do keep port red and starboard green bound to their side; use amber for warnings and coral for alarms.",
      "Do keep help text behind the small info toggle, and keep all text, including canvas and chart labels, at 11px or larger.",
      "Do draw icons as 16px, 1.75-stroke SVG line glyphs.",
      "Do honor reduced motion: only the correction banner, shallow warning and sea overlay animate.",
      "Do keep chart overlay colors on the map vectors and legend only."
    ],
    "donts": [
      "Don't put paragraphs of help text or a stacked form in the sidebar.",
      "Don't use emoji or icon fonts as icons.",
      "Don't add shadows to docked panels or use hard offset shadows.",
      "Don't use saturated color as decoration; it must encode side, state or alarm.",
      "Don't set body prose in DM Mono or numerals in Manrope."
    ]
  }
}