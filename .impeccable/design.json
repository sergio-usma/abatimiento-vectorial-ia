      "css": ".ds-tabs{display:flex;gap:2px;padding:3px;width:260px;background:#08151e;border:1px solid rgba(158,205,214,.13);border-radius:6px} .ds-tab{flex:1;min-height:28px;border:0;border-radius:4px;background:transparent;color:#a7bfc4;font:700 12px 'Manrope',system-ui,sans-serif;cursor:pointer;transition:background .15s,color .15s} .ds-tab:hover{color:#e6efef} .ds-tab[aria-selected=true]{background:#183242;color:#e6efef} .ds-tab:focus-visible{outline:2px solid #5fd6d0;outline-offset:2px}"
