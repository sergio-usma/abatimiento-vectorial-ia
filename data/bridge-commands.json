  {
   "id": "steer_course",
   "cat": "Rumbo",
   "kind": "order",
   "tool": "steer_course",
   "args": {
    "degrees": "{heading}"
   },
   "es": [
    "((navega|navegue|gobierna|gobierne|pon|ponga|coloca|coloque|vaya|ve) )?((con|a|al) )?rumbo {heading}",
    "asi rumbo {heading}",
    "asi al {heading}"
   ],
   "en": [
    "((steer|steady on|steady|come to|make|set) )(course )?{heading}",
    "course {heading}"
   ],
   "say": {
    "es": "Rumbo {heading:spoken}.",
    "en": "Steer course {heading:spoken}."
   },
   "examples": {
    "es": [
     "Navega con rumbo cero nueve cero",
     "Así, rumbo tres cero cero",
     "Rumbo 000"
